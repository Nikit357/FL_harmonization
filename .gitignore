# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db

# ── Office owner-lock stubs ───────────────────────────────────────────────────
~$*

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# ── Jupyter ───────────────────────────────────────────────────────────────────
# Checkpoints shadow every notebook with an unstripped copy -- the easiest way to
# leak outputs past the nbstripout filter configured in .gitattributes.
.ipynb_checkpoints/

# ── Large derived tables and figures kept out of git ──────────────────────────
# Regenerated by run_metrics_concat.py / gene_panel_analysis and by the blind-check
# notebooks; too large to track and fully derivable from what is tracked.
harmonization-metrics/metric_tables/marker_gene_correlations_long.csv
harmonization-metrics/metric_tables/marker_gene_correlations_long_260826.csv
harmonization-metrics/metric_tables/gene_qc_long_260828.csv.gz
figures_for_article/current_figures_tables_for_article_260819/fig5c_group_l_by_gene.svg
figures_for_article/current_figures_tables_for_article_260819/supplementary_file_5/S5_2_marker_gene_correlations_long.csv

# ── R ─────────────────────────────────────────────────────────────────────────
.RData
.Rhistory
.Rproj.user/

# ── Octave (CuBlock step of the Shambhala port) ────────────────────────────────
octave-workspace
octave_debug.log

# ── Run artifacts ─────────────────────────────────────────────────────────────
# The .log and pod-log files already in the tree are part of the reproducibility
# record and are tracked; only name what a *fresh* run would drop here.
nohup.out
prep_run.log
norm_run.log
metrics_fast.log
metrics_lmn.log

# ── Local agent configuration ─────────────────────────────────────────────────
# Excluded on the authoring machine by a *global* gitignore, which a fresh clone
# elsewhere would not have. Name it here so the exclusion is portable.
.claude/settings.local.json
